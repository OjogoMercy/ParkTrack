# ParkTrack environment keys.
# Copy to .env.local and fill in real values there. Never commit real values.
# Every key here is server-only unless its name starts with NEXT_PUBLIC_.

# ── Domains ────────────────────────────────────────────────────────────────
# parktrack.ng in production; localhost:3000 locally (parks at ogbomoso.localhost:3000)
# Browsers won't share a cookie across *.localhost, so with localhost:3000 a
# sign-in only works on the subdomain where it happened. To test one sign-in
# across parks and the console, use parktrack.localhost:3000 for both values
# below and open ogbomoso.parktrack.localhost:3000 / app.parktrack.localhost:3000.
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── Database (Supabase Postgres via Prisma) ────────────────────────────────
# Pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=
# Optional: connection pool size. Use 1 with the local `npx prisma dev` database.
DATABASE_POOL_MAX=

# ── Supabase (Storage for photos, Realtime for live updates) ───────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Sign-in and signed links (jose) ────────────────────────────────────────
# Long random strings, e.g. `openssl rand -base64 48`
AUTH_JWT_SECRET=
LINK_SIGNING_SECRET=

# ── Interswitch Web Checkout (sandbox for the hackathon) ───────────────────
ISW_BASE_URL=
ISW_MERCHANT_CODE=
ISW_PAY_ITEM_ID=
ISW_CLIENT_ID=
ISW_SECRET=
ISW_WEBHOOK_SECRET=

# ── Messaging ──────────────────────────────────────────────────────────────
# console = print messages to the server log; live = send for real
NOTIFY_MODE=console
TERMII_API_KEY=
TERMII_SENDER_ID=
# Your account's base URL from the Termii dashboard, e.g. https://xxxx.api.termii.com
TERMII_BASE_URL=
# Empty = dnd, the transactional route (reaches Do-Not-Disturb numbers;
# ask Termii to activate it). "generic" is for promotions only.
TERMII_CHANNEL=
WA_PHONE_NUMBER_ID=
WA_TOKEN=

# ── Background jobs (Upstash QStash) ───────────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Errors ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
