# ParkTrack environment keys.
# Copy to .env.local and fill in real values there. Never commit real values.
# Every key here is server-only unless its name starts with NEXT_PUBLIC_.

# ── Domains ────────────────────────────────────────────────────────────────
# parktrack.ng in production; localhost:3000 locally. Everything is on this one
# domain (Q45): parks at /parks/<slug>, the staff console at /console. Old
# <park>. and app. subdomain addresses redirect here.
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── Database (Supabase Postgres via Prisma) ────────────────────────────────
# Pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=
# Optional: connection pool size. Use 1 with the local `npx prisma dev` database.
DATABASE_POOL_MAX=

# ── Supabase (Storage for photos, Realtime for live updates) ───────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Sign-in and signed links (jose) ────────────────────────────────────────
# Long random strings, e.g. `openssl rand -base64 48`
AUTH_JWT_SECRET=
LINK_SIGNING_SECRET=

# ── Interswitch Web Checkout (sandbox for the hackathon) ───────────────────
# Empty ISW_ENVIRONMENT = sandbox. Shared sandbox values are published in
# Interswitch's QuickStart (merchant MX6072, pay item 9405967). For
# production set ISW_ENVIRONMENT=live with your own credentials; live
# refuses the shared sandbox merchant.
ISW_ENVIRONMENT=
ISW_BASE_URL=
ISW_MERCHANT_CODE=
ISW_PAY_ITEM_ID=
# Client id and secret: Passport tokens for refunds (server-side only).
ISW_CLIENT_ID=
ISW_SECRET=
# Webhook signing secret from Quickteller Business > Developer Tools >
# Webhooks (URL: https://<your domain>/api/webhooks/interswitch, TRANSACTION
# events). Empty = webhooks are refused (503); payments still confirm via
# the redirect, the status page and the background re-check.
ISW_WEBHOOK_SECRET=

# ── Messaging ──────────────────────────────────────────────────────────────
# console = print messages to the server log; live = send for real
NOTIFY_MODE=console
TERMII_API_KEY=
TERMII_SENDER_ID=
# Your account's base URL from the Termii dashboard, e.g. https://xxxx.api.termii.com
TERMII_BASE_URL=
# Empty = dnd, the transactional route (reaches Do-Not-Disturb numbers;
# ask Termii to activate it). "generic" is for promotions only.
TERMII_CHANNEL=
WA_PHONE_NUMBER_ID=
WA_TOKEN=

# ── Background jobs (Upstash QStash) ───────────────────────────────────────
# Upstash console > QStash: the token and both signing keys. Payments need
# one schedule: POST https://<your domain>/api/jobs/requery, cron
# "*/5 * * * *". Without the keys the job route refuses calls (503).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Errors ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
